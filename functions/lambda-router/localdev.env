AWS_REGION=us-east-1
AWS_SSM_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Whitelist CF verso IO reale (SSM Parameter Store); tutti gli altri CF -> mock
PN_IOCONNECTORMOCK_REALTAXIDSWHITELIST_PARAMETERNAME=MapIoConnectorMockRealTaxIdsWhitelist

# Corsie
# DR4: base path reale del mock da confermare (refuso /api/v1 -> /io-connector-mock)
MOCK_BASE_URL=http://localhost:8080/io-connector-mock
IO_REAL_BASE_URL=https://api.io.pagopa.it/api/v1
